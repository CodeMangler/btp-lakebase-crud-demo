{
  "name": "btp-lakebase-crud-demo",
  "version": "1.0.0",
  "description": "CRUD spike: SAPUI5 -> BTP -> Databricks Lakebase Postgres, mirroring capacityplanningscreens' architecture.",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --livereload false",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy btp-lakebase-crud-demo --delete-services --delete-service-keys --delete-service-brokers",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cap-js/postgres": "^3.1.0",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap/cds": "^10.1.0",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.0",
    "cds-plugin-ui5": "^0.17.4",
    "dotenv": "^17.4.2",
    "mbt": "^1.2.29",
    "rimraf": "^6.1.3",
    "vitest": "^3"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "pool": {
          "acquireTimeoutMillis": 15000
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "planner": {
              "roles": [
                "Planner"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    },
    "watch": {
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.ui5/**"
      ],
      "poll": 500
    }
  }
}
