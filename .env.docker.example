# Local dev against the Dockerized Postgres from docker-compose.yml, instead
# of the real Lakebase instance. Copy to .env (`cp .env.docker.example .env`)
# after `npm run db:up`. Same variable names as .env.example - only the
# values differ - so srv/server.js needs no branch-specific code for this.
LB_HOST=localhost
LB_PORT=5432
LB_DATABASE=databricks_postgres
LB_USER=app_user
LB_PASSWORD=local_dev_password
LB_SSL=false
